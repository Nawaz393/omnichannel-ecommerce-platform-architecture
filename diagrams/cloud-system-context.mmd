flowchart TB
    subgraph CLIENT_TIER ["Client Tier (Browser)"]
        BROWSER["Next.js React 19 UI<br/>(Tailwind CSS v4 & Radix UI)"]
        ZUSTAND["Zustand Store<br/>(cart-v2 in LocalStorage)"]
        ACCEPT_JS["Authorize.Net Accept.js<br/>(PCI-DSS SAQ-A Tokenizer)"]
        GOOGLE_AUTH["Google Identity Services<br/>(GSI OAuth)"]
    end

    subgraph APP_SERVER ["Web Application Platform (Next.js 16 App Router)"]
        APP_ROUTER["Next.js App Router Architecture"]
        SERVER_ACTIONS["Server Actions ('use server')<br/>(Cart Mutations & Popularity Aggregation)"]
        CHECKOUT_ROUTE["Route Handler: /api/checkout<br/>(Distributed Saga Controller)"]
        DOMAIN_SERVICES["Domain API Services<br/>(Auth, User Profile, Addresses)"]
    end

    subgraph DATA_TIER ["Direct POS Database Persistence Tier"]
        PRISMA_ACCEL["Prisma Accelerate<br/>(Connection Pooling & Edge Caching)"]
        POS_DB[("Core POS PostgreSQL Database<br/>(Catalog, Variants, Carts, Orders)")]
        S3_BUCKET[("Amazon S3 Bucket<br/>(Catalog Media & Product Assets)")]
    end

    subgraph EXTERNAL_SERVICES ["External Enterprise Gateways & POS API"]
        AUTH_NET["Authorize.Net Gateway<br/>(Auth-Only, Capture, Void APIs)"]
        HOME_POS_API["In-House POS REST API<br/>(/Voucher/order, /payment Ledger, /Customer)"]
    end

    BROWSER -->|"Local Cart Operations"| ZUSTAND
    BROWSER -->|"Direct Card Submission (PCI Isolated)"| ACCEPT_JS
    ACCEPT_JS -->|"Opaque Payment Nonce"| BROWSER
    BROWSER -->|"SSO Login"| GOOGLE_AUTH
    BROWSER -->|"Invoke Server Actions"| SERVER_ACTIONS
    BROWSER -->|"POST Nonce + Payload"| CHECKOUT_ROUTE

    APP_ROUTER -->|"Serve Optimized Images"| S3_BUCKET
    SERVER_ACTIONS -->|"ACID Cart Transactions & Stock Checks"| PRISMA_ACCEL
    CHECKOUT_ROUTE -->|"Cart & VAT Revalidation"| PRISMA_ACCEL
    PRISMA_ACCEL -->|"Low-Latency TCP Connection Pool"| POS_DB

    CHECKOUT_ROUTE -->|"1. Auth-Only / 3. Capture / Comp Void"| AUTH_NET
    CHECKOUT_ROUTE -->|"2. Create Voucher / 4. Settle Ledger"| HOME_POS_API
    DOMAIN_SERVICES -->|"Direct Customer Auth & Address Management"| HOME_POS_API
